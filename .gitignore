# su licencia no permite redistribuirla. Inter (assets/fonts/*.ttf) si se sube.
assets/*.otf
assets/**/SF-Pro*
assets/**/SFPro*
assets/**/SFUI*

# --- Python ---
__pycache__/
*.pyc
.venv/
venv/

